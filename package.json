{
  "name": "lokal-music",
  "version": "12.5.1",
  "description": "Local-first music player built w/ Electron and React. Designed for people with large local music libraries who'd like a modern listening experience w/o the burdens of streaming subscriptions.",
  "author": "sipbuu <97703296+sipbuu@users.noreply.github.com>",
  "main": "electron/main.js",
  "scripts": {
    "prebuild": "node scripts/check-electron-syntax.cjs",
    "test:electron-syntax": "node scripts/check-electron-syntax.cjs",
    "dev": "npm run gen:icons && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "npm run gen:icons && concurrently \"vite\" \"node server/start.js\"",
    "build": "npm run gen:icons && vite build && npm run native:prepare && electron-builder",
    "server": "node server/start.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:electron": "electron-rebuild",
    "rebuild:web": "npm rebuild better-sqlite3",
    "postinstall": "electron-builder install-app-deps && npm run native:prepare",
    "native:prepare": "node scripts/prepare-native.js",
    "test:home-greeting": "node --test scripts/home-greeting.test.mjs",
    "test:state-persistence": "node --test scripts/state-persistence.test.mjs",
    "test:search-scope": "node --test scripts/search-source-scope.test.mjs",
    "test:home-cover-flow": "node --test scripts/cover-flow.test.mjs scripts/home-cover-choice.test.mjs",
    "test:motion-covers": "node --test scripts/motion-cover-resolution.test.mjs",
    "test:artwork-download": "node --test scripts/artwork-download.test.mjs",
    "test:artist-roles": "node --test scripts/artist-roles.test.mjs",
    "test:gapless": "node --test scripts/gapless-playback.test.mjs",
    "test:network-shares": "node --test scripts/network-share-paths.test.mjs scripts/network-library-scan.test.mjs scripts/network-artwork.test.mjs",
    "test:resolution-tags": "node --test scripts/full-resolution-quality-tags.test.mjs",
    "test:tracklist-navigation": "node --test scripts/tracklist-song-links.test.mjs",
    "test:artist-search-keys": "node --test scripts/artist-search-result-keys.test.mjs",
    "test:discovery-shelves": "node --test scripts/discovery-shelf-customization.test.mjs scripts/spotify-library-playlists.test.mjs scripts/spotify-playlist-cache.test.mjs scripts/youtube-library-playlists.test.mjs scripts/youtube-playlist-session-stability.test.mjs scripts/provider-playlist-visibility.test.mjs",
    "test:ported": "node --test scripts/artist-metadata-rescan.test.mjs scripts/artist-split.test.mjs scripts/cover-mix.test.mjs scripts/download-addon-pacing.test.mjs scripts/genre-cleanup.test.mjs scripts/genre-playlist.test.mjs scripts/file-tags.test.mjs scripts/library-folder-view.test.mjs scripts/library-folder-operations.test.mjs scripts/library-watch.test.mjs scripts/video-section-dedupe.test.mjs scripts/pr222-regression.test.mjs scripts/online-browse.test.mjs scripts/release-types.test.mjs scripts/replaygain.test.mjs scripts/review-fixes.test.mjs scripts/yandex-music-package.test.mjs scripts/issue-458-regression.test.mjs scripts/issue-660-imported-elrc.test.mjs scripts/mpris-config.test.mjs scripts/file-artwork.test.mjs scripts/artwork-download.test.mjs scripts/artist-roles.test.mjs scripts/fullscreen-visualizer-settings.test.mjs scripts/fullscreen-appearance.test.mjs scripts/fullscreen-lyrics-layout.test.mjs scripts/cover-flow.test.mjs scripts/tracklist-song-links.test.mjs scripts/gapless-playback.test.mjs scripts/full-resolution-quality-tags.test.mjs scripts/discovery-shelf-customization.test.mjs",
    "test:desktop-link-playlists": "node --test scripts/desktop-link-playlist-reconcile.test.mjs",
    "test:phone-copy": "node --test scripts/phone-file-naming.test.mjs scripts/phone-file-legacy-migration.test.mjs scripts/phone-copy-integrity.test.mjs",
    "test:atmos": "node --test scripts/tidal-atmos-metadata.test.mjs scripts/atmos-output.test.mjs scripts/atmos-transfer-progress.test.mjs scripts/atmos-library-quality.test.mjs scripts/atmos-stereo-handoff.test.mjs scripts/atmos-downloads.test.mjs scripts/atmos-codec-help.test.mjs scripts/online-native-dolby.test.mjs scripts/http-addon-atmos.test.mjs",
    "test:loading-toasts": "node --test scripts/loading-toast-progress.test.mjs scripts/stream-buffer-progress.test.mjs scripts/recommendations.test.mjs scripts/recommendation-downloads.test.mjs scripts/ghost-downloads.test.mjs",
    "test:catalogue-quality": "node --test scripts/catalogue-quality.test.mjs",
    "test:mpris": "node --test scripts/mpris-config.test.mjs",
    "test:added-date": "node --test scripts/added-date.test.mjs",
    "test:download-folder": "node --test scripts/download-folder.test.mjs",
    "test:lyrics-voice-prefix": "node --test scripts/lrc-voice-prefix.test.mjs",
    "test:issue-660": "node --test scripts/issue-660-imported-elrc.test.mjs",
    "test:visualizer-analyser-startup": "node --test scripts/visualizer-analyser-startup.test.mjs",
    "test:fullscreen-visualizer-settings": "node --test scripts/fullscreen-visualizer-settings.test.mjs",
    "test:fullscreen-appearance": "node --test scripts/fullscreen-appearance.test.mjs scripts/fullscreen-lyrics-layout.test.mjs",
    "gen:icons": "node scripts/generate-brand-icons.cjs",
    "test:brand-icons": "node --test scripts/brand-icons.test.cjs"
  },
  "build": {
    "appId": "com.lokal.music",
    "productName": "Lokal",
    "icon": "public/lokal-icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/artworkQuality.mjs",
      "package.json",
      "server/**/*",
      "public/remote.html",
      "public/remote-manifest.json",
      "public/remote-sw.js",
      "public/lokal-icon.png",
      "public/lokal-icon-rounded.png"
    ],
    "extraResources": [
      {
        "from": "public/remote.html",
        "to": "public/remote.html"
      },
      {
        "from": "public/remote-manifest.json",
        "to": "public/remote-manifest.json"
      },
      {
        "from": "public/remote-sw.js",
        "to": "public/remote-sw.js"
      },
      {
        "from": "public/lokal-icon.png",
        "to": "public/lokal-icon.png"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "electron/native/**/*.node",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "lokal-music",
      "repo": "lokal"
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/lokal-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "mp3",
            "flac",
            "m4a",
            "ogg",
            "wav",
            "aac",
            "opus",
            "wma",
            "alac",
            "ape"
          ],
          "name": "Audio File",
          "description": "Audio File",
          "role": "Viewer",
          "icon": "public/lokal-icon.ico"
        }
      ],
      "extraResources": [
        {
          "from": "build/webview2-signin",
          "to": "webview2-signin",
          "filter": [
            "**/*",
            "!*.pdb"
          ]
        }
      ]
    },
    "appx": {
      "artifactName": "${productName}-${version}-${arch}.msix",
      "applicationId": "Lokal",
      "identityName": "Sipbuu.LokalMusic",
      "publisher": "CN=C9C2BE38-8ED4-4D74-9660-28C2ACA032D7",
      "publisherDisplayName": "Sipbuu",
      "displayName": "Lokal Music",
      "backgroundColor": "transparent",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0",
      "languages": [
        "en-US"
      ]
    },
    "mac": {
      "icon": "public/lokal-icon-rounded.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category-music"
    },
    "linux": {
      "icon": "public/lokal-icon-rounded.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Music",
      "maintainer": "sipbuu <97703296+sipbuu@users.noreply.github.com>"
    }
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.3",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "bgutils-js": "^4.0.3",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7",
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.4.5",
    "egoroof-blowfish": "4.0.2",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "express": "^4.18.3",
    "fs-extra": "^11.3.3",
    "icecast-metadata-player": "1.17.13",
    "multicast-dns": "^7.2.5",
    "music-metadata": "^12.0.0",
    "node-taglib-sharp": "^6.0.3",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "0.32.0",
    "sharp": "^0.35.5",
    "three": "^0.175.0",
    "tough-cookie": "6.0.0",
    "webwallgl": "3.0.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@electron/rebuild": "^4.2.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^8.2.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "framer-motion": "^11.0.8",
    "lucide-react": "^1.52.0",
    "node-gyp": "12.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wait-on": "^7.2.0",
    "zustand": "^4.5.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
